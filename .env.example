# Public Supabase values. Use the current publishable key (recommended) or a legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Recommended current Supabase secret key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=

# Optional but recommended in production to preserve the CAPTCHA protection from Power Pages.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
